{
  "Jwt": {
    "Key": "super_secret_key_12345_super_secret_key_67890",
    "Issuer": "ihbplatform",
    "Audiences": [
      "ihbplatform",
      "internal"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/user/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/user" }]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/order/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/order" }]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": { "Path": "/billing/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/billing" }]
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/delivery/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/delivery" }]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/inventory/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/inventory" }]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/notification" }]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user_api": { "Address": "http://localhost:5000" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order_api": { "Address": "http://localhost:5000" }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing_api": { "Address": "http://localhost:5000" }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery_api": { "Address": "http://localhost:5000" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory_api": { "Address": "http://localhost:5000" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification_api": { "Address": "http://localhost:5000" }
        }
      }
    }
  }
}